{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  // One slot per persistent workspace `dev` (currently 3 Workers), plus headroom.
  // Turbo requires concurrency > number of concurrent persistent tasks.
  "concurrency": "8",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
