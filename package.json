{
  "name": "tomokichi-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "admin:migrate:local": "pnpm --filter @tomokichi/admin-core run migrate:local",
    "admin:migrate:remote": "pnpm --filter @tomokichi/admin-core run migrate:remote",
    "admin:seed": "pnpm --filter @tomokichi/admin-core run seed",
    "build": "turbo run build",
    "build:review": "node apps/review/scripts/build.mjs",
    "cf": "pnpm --filter @tomokichi/api exec wrangler",
    "check": "turbo run check",
    "check:links": "node scripts/check-static-links.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "ci": "biome ci . && pnpm check && pnpm test && pnpm build && pnpm check:links && pnpm check:seo",
    "create:app-site": "node scripts/create-app-site.mjs",
    "deploy:admin-core": "pnpm --filter @tomokichi/admin-core run deploy",
    "deploy:admin-web": "pnpm --filter @tomokichi/admin-web run deploy",
    "deploy:api": "pnpm --filter @tomokichi/api run deploy",
    "deploy:colorvia": "pnpm --filter @tomokichi/colorvia run deploy",
    "deploy:mail-ingress": "pnpm --filter @tomokichi/mail-ingress run deploy",
    "deploy:main": "pnpm --filter @tomokichi/main run deploy",
    "deploy:remeet": "pnpm --filter @tomokichi/remeet run deploy",
    "deploy:review": "pnpm build:review && pnpm --filter @tomokichi/yohaku exec wrangler deploy --config ../../apps/review/wrangler.jsonc",
    "deploy:tripory": "pnpm --filter @tomokichi/tripory run deploy",
    "deploy:yohaku": "pnpm --filter @tomokichi/yohaku run deploy",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  }
}
