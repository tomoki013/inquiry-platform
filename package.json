{
  "name": "inquiry-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "ci": "biome ci . && pnpm check && pnpm test && pnpm build",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "migrate:local": "pnpm --filter @inquiry-platform/api run migrate:local",
    "migrate:remote": "pnpm --filter @inquiry-platform/api run migrate:remote",
    "seed": "pnpm --filter @inquiry-platform/api run seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3"
  }
}
