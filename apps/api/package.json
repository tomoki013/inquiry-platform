{
  "name": "@inquiry-platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "build": "wrangler deploy --dry-run",
    "check": "wrangler types --env-interface CloudflareBindings --strict-vars=false && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "vapid:generate": "node --experimental-strip-types scripts/generate-vapid-keys.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false"
  },
  "dependencies": {
    "@inquiry-platform/core": "workspace:*",
    "@inquiry-platform/mail-parser": "workspace:*",
    "@inquiry-platform/notification": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@inquiry-platform/sdk": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
