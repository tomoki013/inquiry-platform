{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tomokichi-admin-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",

  // The Worker name is the one tomokichi-studio deployed before this
  // repository existed, kept so every Service Binding and the D1 / R2 below stay
  // where they are. Renaming is a separate, later change.
  //
  // Never on the internet. No route, no custom domain, and `workers.dev` off:
  // the only ways in are the Service Bindings declared by the admin console,
  // the mail Worker and `tomokichi-api`. That is what lets this Worker hold the D1 and
  // R2 bindings while Admin Web holds neither.
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },

  "observability": {
    "enabled": true
  },

  "vars": {
    // Addresses live here, not in code, so a Workspace migration is a config
    // change. The operator's own forwarding address is a Secret, not a var.
    "SUPPORT_EMAIL": "support@tmkch.io",
    "SUPPORT_FROM_NAME": "Tomokichi Studio Support",
    "NOREPLY_EMAIL": "notification@tmkch.io",
    "REPORT_EMAIL": "report@tmkch.io",
    "DEFAULT_SUPPORT_URL": "https://tmkch.io/support",
    // Where a notification's "open in admin" link points.
    "ADMIN_ORIGIN": "https://admin.tmkch.io",
    // Web Push. The public key is handed to every browser that subscribes, so
    // it is a var; the private half is the Secret `VAPID_PRIVATE_KEY`. Empty
    // means push is unavailable and the settings screen says so. Generate a
    // pair with `pnpm --filter @inquiry-platform/api run vapid:generate`.
    "VAPID_PUBLIC_KEY": "BH_x4ecKrNnv73trqmRzVywqkJWYyVIRySWdiK8XP8GQYF1UlSFcO5jXYoZeWIPasjEcCaULEdS58hmLWmWbES0",
    "VAPID_SUBJECT": "mailto:support@tmkch.io",
    // Everything this deployment calls itself. Code reads it through
    // `parseBranding` (packages/core/src/branding.ts) and never names it.
    "BRANDING": {
      "consoleName": "Tomokichi Studio",
      "consoleShortName": "Tomokichi",
      "defaultSignature": "Tomokichi Studio\n髙木友喜 / Tomoki Takagi\n────────────────────────\nhttps://tmkch.io\nsupport@tmkch.io  ·  080-6648-1475",
      "legacySignatures": [
        "────────────────────────\nTomokichi Studio\n髙木 友喜\n\nWeb: https://tmkch.io\nEmail: support@tmkch.io\nTEL: 080-6648-1475\n────────────────────────"
      ],
      "mailLogo": { "url": "https://tmkch.io/assets/mail-logo.png", "alt": "Tomokichi Studio" },
      "defaultProjectId": "studio"
    },
    // Projects whose reported content is acted on by a signed decision through
    // their own adapter: project slug → Service Binding name (below).
    "SIGNED_MODERATION": { "remeet": "REMEET_MODERATION" }
  },

  "services": [
    { "binding": "REMEET_MODERATION", "service": "tomokichi-api", "entrypoint": "RemeetModeration" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tomokichi-admin",
      "database_id": "303d025d-51a8-4a90-9a19-97a08d715ec3",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // Private. Report evidence and support attachments. No public URL is ever
      // generated; bytes are read back through Admin Web behind Access.
      "binding": "PRIVATE_FILES",
      "bucket_name": "tomokichi-admin-files"
    }
  ]
}
