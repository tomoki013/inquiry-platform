{
  "name": "@tomokichi/admin-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "build": "wrangler deploy --dry-run",
    "check": "wrangler types --env-interface CloudflareBindings --strict-vars=false && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply tomokichi-admin --local",
    "migrate:remote": "wrangler d1 migrations apply tomokichi-admin --remote",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false"
  },
  "dependencies": {
    "@tomokichi/admin-contracts": "workspace:*",
    "@tomokichi/admin-mail": "workspace:*",
    "hono": "^4.13.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
