{
  "name": "@inquiry-platform/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 4330",
    "build": "wrangler deploy --dry-run",
    "check": "wrangler types --env-interface CloudflareBindings --strict-vars=false && tsc --noEmit",
    "test": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --strict-vars=false"
  },
  "dependencies": {
    "@inquiry-platform/core": "workspace:*",
    "hono": "^4.13.13",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  }
}
