{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inquiry-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-23",

  // The one entrance. `workers.dev` is off deliberately: a Cloudflare Access
  // policy is attached to a hostname, so leaving the `*.workers.dev` URL up
  // would be a second door that Access does not cover. The Worker verifies the
  // JWT itself and would refuse that door anyway — this closes it regardless.
  "workers_dev": false,
  // A deployment adds its own hostname in its copy of this file, e.g.
  //   "routes": [{ "pattern": "api.example.com", "custom_domain": true }]

  "observability": {
    "enabled": true
  },

  "vars": {
    // Cloudflare Access. The AUD tag identifies the Application and is not a
    // secret — it appears in every JWT this Worker verifies. Fill both in after
    // creating the Access application; empty means "refuse everything" in
    // production, not "allow everything".
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Origin of a browser client, if one is used. Bearer API clients do not
    // need this value; the gateway deliberately emits no CORS headers.
    "ADMIN_ORIGIN": "https://operator.example.com",
    "ENVIRONMENT": "production",
    // The role of anybody the Access policy admits who is not named in
    // ADMIN_ROLES (Access subject id → role). Unset means `viewer`.
    "DEFAULT_ADMIN_ROLE": "viewer"
  },

  "services": [
    {
      // The only binding this Worker has. No D1 and no R2: the internet-facing
      // API cannot reach the database even if a route handler is
      // wrong. Least privilege, and the reason Core is separated at all.
      "binding": "ADMIN_CORE",
      "service": "inquiry-core",
      "entrypoint": "AdminCore"
    }
  ]
}
